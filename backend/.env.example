APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=art_pro
DB_USERNAME=art_pro
DB_PASSWORD=change-me

# Use a cryptographically random value containing at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_AUDIENCE=art-pro
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_LEEWAY=30

ACCESS_TOKEN_COOKIE=token
REFRESH_TOKEN_COOKIE=refresh_token
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Keep true for direct API clients. A future browser BFF should set this to false.
AUTH_RETURN_TOKENS=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Temporary compatibility switch while the frontend moves to /api/v1.
ENABLE_LEGACY_API_ROUTES=true
